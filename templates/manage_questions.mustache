{{!
    @template mod_videoevidence/manage_questions

    Example context (json):
    {
        Aqui tem que criar o context em inglês
    }
}}
<div class="d-flex justify-content-between align-items-center mb-3"><h2>{{#str}}
    managequestions, videoevidence{{/str}} — {{name}}</h2>
    <div><a class="btn btn-primary" href="{{{addurl}}}">{{#str}}addquestion, videoevidence{{/str}}</a> <a
            class="btn btn-secondary" href="{{{viewurl}}}">{{#str}}backtoactivity, videoevidence{{/str}}</a></div>
</div>
{{^hasquestions}}
    <div class="alert alert-info">{{#str}}noquestions, videoevidence{{/str}}</div>{{/hasquestions}}
{{#questions}}
    <div class="card mb-2">
        <div class="card-body">
            <div class="d-flex justify-content-between"><strong>{{number}}</strong>
                <div>{{#upurl}}
                    <a class="btn btn-sm btn-outline-secondary" href="{{{upurl}}}">↑</a>{{/upurl}} {{#downurl}}
                    <a class="btn btn-sm btn-outline-secondary" href="{{{downurl}}}">↓</a>{{/downurl}} <a
                        class="btn btn-sm btn-outline-primary" href="{{{editurl}}}">{{#str}}edit, core{{/str}}</a> <a
                        class="btn btn-sm btn-outline-danger" href="{{{deleteurl}}}">{{#str}}delete, core{{/str}}</a>
                </div>
            </div>
            <div>{{{text}}}</div>
            <small>{{#str}}evidencerequirement, videoevidence, {"min":{{min}},"max":{{max}}}{{/str}}</small></div>
    </div>{{/questions}}
