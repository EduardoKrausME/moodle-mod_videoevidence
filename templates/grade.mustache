{{!
    @template mod_videoevidence/grade

    Example context (json):
    {
        Aqui tem que criar o context em inglês
    }
}}
<div class="d-flex justify-content-between mb-3">
    <div><h2>{{#str}}grade, videoevidence{{/str}} — {{student}}</h2>
        <div>{{name}}</div>
    </div>
    <a class="btn btn-secondary" href="{{{reporturl}}}">{{#str}}backtoreport, videoevidence{{/str}}</a></div>
<form method="post"><input type="hidden" name="sesskey" value="{{sesskey}}">
    {{#items}}
        <section class="card mb-3">
            <div class="card-body"><h3 class="h5">{{#str}}questionnumber, videoevidence, {{number}}{{/str}}</h3>
                <div>{{{questiontext}}}</div>
                <div class="small text-muted mb-2">{{status}}</div>{{#hasevidence}}{{#evidence}}
                    <div class="border rounded p-2 mb-2"><strong>{{range}}</strong>
                        <div>{{justification}}</div>
                    </div>{{/evidence}}{{/hasevidence}}{{^hasevidence}}
                    <div class="alert alert-light">{{#str}}
                        noevidence, videoevidence{{/str}}</div>{{/hasevidence}}{{#cangrade}}
                    <div class="row g-2">
                        <div class="col-md-4"><label class="form-label">{{#str}}
                            selectionscore, videoevidence{{/str}}</label><input class="form-control" type="number"
                                                                                min="0" max="100" step="0.1"
                                                                                name="selectionscore_{{answerid}}"
                                                                                value="{{selectionscore}}"></div>
                        <div class="col-md-4"><label class="form-label">{{#str}}
                            justificationscore, videoevidence{{/str}}</label><input class="form-control" type="number"
                                                                                    min="0" max="100" step="0.1"
                                                                                    name="justificationscore_{{answerid}}"
                                                                                    value="{{justificationscore}}">
                        </div>
                        <div class="col-md-4"><label class="form-label">{{#str}}
                            quantityscore, videoevidence{{/str}}</label><input class="form-control" type="number"
                                                                               min="0" max="100" step="0.1"
                                                                               name="quantityscore_{{answerid}}"
                                                                               value="{{quantityscore}}"></div>
                    </div>
                    <label class="form-label mt-2">{{#str}}feedback, videoevidence{{/str}}</label><textarea
                        class="form-control" name="feedback_{{answerid}}" rows="2">{{feedback}}</textarea>{{/cangrade}}
            </div>
        </section>{{/items}}
    <button type="submit" class="btn btn-primary">{{#str}}savegrades, videoevidence{{/str}}</button>
</form>
