{{!
    @template mod_videoevidence/report

    Example context (json):
    {
        Aqui tem que criar o context em inglês
    }
}}
<div class="d-flex justify-content-between mb-3"><h2>{{#str}}report, videoevidence{{/str}} — {{name}}</h2><a
        class="btn btn-secondary" href="{{{viewurl}}}">{{#str}}backtoactivity, videoevidence{{/str}}</a></div>
{{^hasrows}}
    <div class="alert alert-info">{{#str}}nostudents, videoevidence{{/str}}</div>{{/hasrows}}
{{#hasrows}}
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
            <tr>
                <th>{{#str}}student, videoevidence{{/str}}</th>
                <th>{{#str}}questionsanswered, videoevidence{{/str}}</th>
                <th>{{#str}}evidenceselected, videoevidence{{/str}}</th>
                <th>{{#str}}submitted, videoevidence{{/str}}</th>
                <th>{{#str}}watchedpercent, videoevidence{{/str}}</th>
                <th>{{#str}}score, videoevidence{{/str}}</th>
                <th></th>
            </tr>
            </thead>
            <tbody>{{#rows}}
                <tr>
                    <td>{{fullname}}
                        <div class="small text-muted">{{email}}</div>
                    </td>
                    <td>{{answered}} / {{questioncount}}</td>
                    <td>{{evidencecount}}</td>
                    <td>{{submitted}} / {{questioncount}}</td>
                    <td>{{percent}}%</td>
                    <td>{{score}}</td>
                    <td><a class="btn btn-sm btn-primary" href="{{{gradeurl}}}">{{#str}}grade, videoevidence{{/str}}</a>
                    </td>
                </tr>{{/rows}}</tbody>
        </table>
    </div>{{/hasrows}}
